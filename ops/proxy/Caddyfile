{
    admin 127.0.0.1:2019
    auto_https disable_redirects
    skip_install_trust
}

http://{$PALDO_PROXY_HOST} {
    bind {$PALDO_PROXY_HOST}
    redir https://{host}{uri} 308
}

https://{$PALDO_PROXY_HOST} {
    bind {$PALDO_PROXY_HOST}
    tls internal
    header -Strict-Transport-Security

    handle_path /static/* {
        root * {$PALDO_STATIC_ROOT}
        file_server
    }

    # 게임 웹 daphne 2개(E-09-10, ops/mysql/service_runtime.py web --port 8000|8002). 1개로 되돌릴 때는
    # 8002 프로세스만 멈추면 능동 상태 확인이 그 upstream을 빼고, 접속 실패는 다른 upstream으로 다시 보낸다.
    handle {
        reverse_proxy 127.0.0.1:8000 127.0.0.1:8002 {
            lb_policy least_conn
            lb_try_duration 2s
            lb_try_interval 250ms
            fail_duration 10s
            health_uri /healthz
            health_interval 5s
            health_timeout 5s
            health_fails 3
            health_passes 1
            health_headers {
                Host {$PALDO_PROXY_HOST}
            }
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
}
