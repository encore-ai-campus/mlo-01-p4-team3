{
  "id": null,
  "uid": "paldo-c08-model",
  "title": "PJ4 model",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "pj4",
    "C-08-01"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 99,
      "type": "text",
      "title": "Scope",
      "options": {
        "mode": "markdown",
        "content": "The current model is fake-suspicion-1 baseline. Canary alerts require real tagged games; no canary is fabricated."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Inference p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum(rate(paldo_model_inference_duration_seconds_bucket[5m])) by (le,model_version))",
          "legendFormat": "{{notebook}} {{vm}} {{model_version}} {{campaign}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Engine fallback ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(paldo_model_decisions_total{result=\"fallback\"}[5m])) / sum(rate(paldo_model_decisions_total[5m]))",
          "legendFormat": "{{notebook}} {{vm}} {{model_version}} {{campaign}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Actual configured version",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "paldo_model_info",
          "legendFormat": "{{notebook}} {{vm}} {{model_version}} {{campaign}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      }
    ]
  }
}
