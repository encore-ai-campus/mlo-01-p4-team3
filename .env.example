# 로컬 개발용 Compose(ops/compose/dev.yml) 비밀값 양식.
# 이 파일에는 변수 이름과 자리표시자만 둔다(C-05-03 조건 4). 실제 값은 Git이 추적하지 않는 .env에 둔다.
# .env 만들기: python -m ops.compose.run make-env   (자리표시자마다 무작위 값을 채운다. 이미 있으면 덮어쓰지 않는다)

# MongoDB 관리자 계정(레플리카셋 1노드)
MONGO_INITDB_ROOT_USERNAME=<MONGO_USER>
MONGO_INITDB_ROOT_PASSWORD=<MONGO_PASSWORD>

# MySQL(광고 DB). 데이터베이스 이름 paldo_ads는 dev.yml에 있다
MYSQL_ROOT_PASSWORD=<MYSQL_ROOT_PASSWORD>
MYSQL_USER=<MYSQL_USER>
MYSQL_PASSWORD=<MYSQL_PASSWORD>

# Garage(S3 호환 저장소). 키 ID는 GK + 16진수 24자, 비밀 키와 RPC 비밀은 16진수 64자
GARAGE_RPC_SECRET=<GARAGE_RPC_SECRET>
GARAGE_ADMIN_TOKEN=<GARAGE_ADMIN_TOKEN>
GARAGE_KEY_ID=<GARAGE_KEY_ID>
GARAGE_SECRET_KEY=<GARAGE_SECRET_KEY>

# Grafana 관리자 계정
GF_SECURITY_ADMIN_USER=<GRAFANA_USER>
GF_SECURITY_ADMIN_PASSWORD=<GRAFANA_PASSWORD>
