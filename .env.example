# 주소·비밀 환경 변수 양식(C-05-03 조건 4). 변수 이름과 자리표시자만 둔다. 실제 값은 Git이 추적하지 않는 .env에 둔다.
# 로컬 .env 만들기: python -m ops.compose.run make-env
#   자리표시자마다 로컬 Compose 값(주소·포트) 또는 무작위 값(비밀)을 채운다. 같은 자리표시자는 같은 값이다. 이미 있으면 덮어쓰지 않는다.
# VM·AWS에서는 같은 이름에 그 환경의 값만 넣는다(docs/contracts/integration.md 4.1).

# ---- 앱이 읽는 변수(integration.md 4.1, PALDO_ 접두)
PALDO_MONGO_URI=<MONGO_URI>
PALDO_KAFKA_BOOTSTRAP=<KAFKA_BOOTSTRAP>
PALDO_S3_ENDPOINT=<S3_ENDPOINT>
PALDO_S3_ACCESS_KEY=<S3_ACCESS_KEY>
PALDO_S3_SECRET_KEY=<S3_SECRET_KEY>
PALDO_MLFLOW_URI=<MLFLOW_URI>
PALDO_LLM_URL=<LLM_URL>
PALDO_ADS_INTERNAL_URL=<ADS_INTERNAL_URL>
PALDO_ADS_PUBLIC_URL=<ADS_PUBLIC_URL>
PALDO_ADS_DB_HOST=<ADS_DB_HOST>
# 비어 있으면 3306(VM·AWS). 로컬 Compose MySQL의 호스트 포트도 이 값을 쓴다(3306을 다른 프로그램이 쓰면 바꾼다)
PALDO_ADS_DB_PORT=<ADS_DB_PORT>
PALDO_ADS_DB_NAME=<ADS_DB_NAME>
PALDO_ADS_DB_USER=<MYSQL_USER>
PALDO_ADS_DB_PASSWORD=<MYSQL_PASSWORD>
PALDO_ADS_TOKEN_KEY=<ADS_TOKEN_KEY>
PALDO_PROMETHEUS_URL=<PROMETHEUS_URL>
DJANGO_SECRET_KEY=<DJANGO_SECRET_KEY>

# ---- 로컬 Compose 컨테이너 초기화용(이미지가 정한 이름. 앱은 읽지 않는다)
MONGO_INITDB_ROOT_USERNAME=<MONGO_USER>
MONGO_INITDB_ROOT_PASSWORD=<MONGO_PASSWORD>
MYSQL_ROOT_PASSWORD=<MYSQL_ROOT_PASSWORD>
MYSQL_USER=<MYSQL_USER>
MYSQL_PASSWORD=<MYSQL_PASSWORD>
GARAGE_RPC_SECRET=<GARAGE_RPC_SECRET>
GARAGE_ADMIN_TOKEN=<GARAGE_ADMIN_TOKEN>
GF_SECURITY_ADMIN_USER=<GRAFANA_USER>
GF_SECURITY_ADMIN_PASSWORD=<GRAFANA_PASSWORD>
