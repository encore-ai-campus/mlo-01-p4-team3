#!/bin/sh
# 푸시 전 로컬 검사(README 3절 ②, 11/5 PM 결정으로 GitHub Actions CI 대신).
# 설치(처음 한 번): git config core.hooksPath .githooks
# 푸시하는 커밋마다 검사한다. 그 커밋이 지금 HEAD이고 작업 트리가 깨끗하면 제자리에서,
# 아니면(다른 브랜치를 푸시하거나 커밋하지 않은 변경이 있으면) 임시 worktree에 그 커밋을 꺼내 검사한다.
# 실패하면 푸시를 멈춘다. 태그 푸시와 브랜치 삭제 푸시는 검사하지 않는다.
zero=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
if command -v python >/dev/null 2>&1; then py=python; else py=python3; fi

check_sha() {
  sha=$1
  head=$(git rev-parse HEAD)
  if [ "$sha" = "$head" ] && [ -z "$(git status --porcelain)" ]; then
    PYTHONIOENCODING=utf-8 "$py" -m tools.precheck
    return $?
  fi
  tmp=$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}/precheck.$$")
  git worktree add --quiet --detach "$tmp/wt" "$sha" || return 1
  (cd "$tmp/wt" && PYTHONIOENCODING=utf-8 "$py" -m tools.precheck)
  rc=$?
  git worktree remove --force "$tmp/wt" >/dev/null 2>&1
  rmdir "$tmp" 2>/dev/null
  return $rc
}

seen=0
fail=0
checked=" "
while read -r local_ref local_sha remote_ref remote_sha; do
  seen=1
  case "$local_ref" in
    refs/tags/*) continue ;;
  esac
  [ "$local_sha" = "$zero" ] && continue
  case "$checked" in
    *" $local_sha "*) continue ;;
  esac
  checked="$checked$local_sha "
  echo "pre-push: $local_ref ($(echo "$local_sha" | cut -c1-7)) 검사"
  check_sha "$local_sha" || fail=1
done

# 표준 입력이 비어 있으면(직접 실행 등) 지금 HEAD를 검사한다.
if [ "$seen" = 0 ]; then
  check_sha "$(git rev-parse HEAD)" || fail=1
fi
if [ "$fail" -ne 0 ]; then
  echo "pre-push: precheck 실패로 푸시를 멈춤(고친 뒤 다시 푸시)." >&2
  exit 1
fi
exit 0
